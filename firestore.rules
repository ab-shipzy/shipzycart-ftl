rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /workspaces/{ws} {
      allow read, create, update: if request.auth != null;
      allow delete: if false;
      match /state/{docId} {
        // App state (shipments, warehouses, config…) may be read and
        // updated by signed-in users, but never deleted — protects
        // against a wiped doc taking the whole dataset with it.
        allow read, create, update: if request.auth != null;
        allow delete: if false;
      }
      match /presence/{docId} {
        allow read, write: if request.auth != null;
      }
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
